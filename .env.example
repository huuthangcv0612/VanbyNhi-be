# Server Environment
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/vanbynhi?schema=public"

# JWT Authentication (Access Token)
# Sinh secret an toàn bằng lệnh: openssl rand -hex 32
JWT_ACCESS_SECRET="your-access-secret-key-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"

# Refresh Token (Opaque token ngẫu nhiên, lưu hash SHA-256 trong database)
JWT_REFRESH_EXPIRES_DAYS="7"

# Zalo OAuth V4 Configuration
ZALO_APP_ID="your-zalo-app-id"
ZALO_APP_SECRET="your-zalo-app-secret"
ZALO_CALLBACK_URL="http://localhost:3000/auth/zalo/callback"
FRONTEND_URL="http://localhost:5173"

# Cloudflare R2 Storage (Private Bucket & Presigned URLs)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="vanbynhi-documents"
# R2_ENDPOINT tùy chọn nếu muốn ghi đè (mặc định https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=""
R2_REGION="auto"
R2_PRESIGNED_URL_TTL_SECONDS="300"
MAX_UPLOAD_SIZE_BYTES="104857600" # 100MB
ALLOWED_DOCUMENT_MIME_TYPES="application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/plain,image/jpeg,image/png,image/webp,application/zip,application/x-zip-compressed"

