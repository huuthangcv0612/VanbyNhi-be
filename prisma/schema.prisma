generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== ENUMS ====================

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum ClassStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  CLOSED
}

enum MemberStatus {
  PENDING
  ACTIVE
  REJECTED
  LEFT
  REMOVED
  INACTIVE
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum MaterialType {
  DOCUMENT
  RECORDING
  IMAGE
  LINK
  OTHER
}

enum TuitionStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum AssignmentStatus {
  SUBMITTED
  GRADED
  RESUBMIT_REQUESTED
}

enum NotificationType {
  TUITION
  SESSION
  ASSIGNMENT
  ATTENDANCE
  SYSTEM
  CALENDAR
}

enum CalendarNotificationStatus {
  PENDING
  PROCESSING
  SENT
  CANCELLED
  FAILED
}

enum MeetingType {
  ONLINE_MEET
  ONLINE_WEB
  IN_PERSON
}

enum ScheduleStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// ==================== MODELS ====================

model User {
  id           String    @id @default(cuid())
  fullName     String
  phone        String    @unique
  passwordHash String
  email        String?   @unique
  zaloId       String?   @unique
  avatarUrl    String?
  dateOfBirth  DateTime?
  role         UserRole  @default(STUDENT)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  authAccounts            AuthAccount[]
  createdClasses          Class[]                  @relation("ClassCreator")
  teachingClasses         Class[]                  @relation("ClassTeacher")
  enrollments             Enrollment[]             @relation("StudentEnrollments")
  createdSessions         ClassSession[]           @relation("SessionCreator")
  attendances             Attendance[]             @relation("StudentAttendances")
  markedAttendances       Attendance[]             @relation("AttendanceMarker")
  attendanceChanges       AttendanceChangeLog[]    @relation("AttendanceModifier")
  uploadedMaterials       ClassMaterial[]          @relation("MaterialUploader")
  createdAssignments      Assignment[]             @relation("AssignmentCreator")
  submissions             AssignmentSubmission[]   @relation("StudentSubmissions")
  gradedSubmissions       AssignmentSubmission[]   @relation("SubmissionGrader")
  recordedTuitionPayments TuitionPayment[]         @relation("PaymentRecorder")
  voidedTuitionPayments   TuitionPayment[]         @relation("PaymentVoider")
  notifications           Notification[]           @relation("UserNotifications")
  refreshTokens           RefreshToken[]
  teacherCalendarEvents   TeacherCalendarEvent[]   @relation("TeacherCalendarEvents")
  teacherCalendarLabels   TeacherCalendarLabel[]   @relation("TeacherCalendarLabels")
  calendarParticipations  CalendarEventParticipant[] @relation("StudentCalendarParticipations")
  calendarNotifications   CalendarNotification[]   @relation("CalendarNotificationRecipient")

  @@index([role, isActive])
  @@index([fullName])
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Class {
  id             String      @id @default(cuid())
  name           String
  description    String?
  classCode      String      @unique @default(cuid())
  joinCode       String      @unique @default(cuid())
  maxStudents    Int?
  defaultMeetUrl String?
  monthlyTuition Decimal     @default(0) @db.Decimal(12, 2)
  status         ClassStatus @default(ACTIVE)
  createdById    String
  teacherId      String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  creator        User                   @relation("ClassCreator", fields: [createdById], references: [id], onDelete: Restrict)
  teacher        User                   @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  members        Enrollment[]
  sessions       ClassSession[]
  materials      ClassMaterial[]
  assignments    Assignment[]
  calendarEvents TeacherCalendarEvent[]

  @@index([teacherId, status])
  @@index([createdById])
  @@index([name])
  @@index([joinCode])
}

model Enrollment {
  id              String       @id @default(cuid())
  classId         String
  studentId       String
  tuitionOverride Decimal?     @db.Decimal(12, 2)
  status          MemberStatus @default(ACTIVE)
  requestedAt     DateTime     @default(now())
  approvedAt      DateTime?
  rejectedAt      DateTime?
  joinedAt        DateTime?
  leftAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  class       Class        @relation(fields: [classId], references: [id], onDelete: Restrict)
  student     User         @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Restrict)
  tuitionFees TuitionFee[]

  @@map("ClassMember")
  @@index([studentId, status])
  @@index([classId, status])
  @@index([classId, studentId, status])
}

model ClassSession {
  id          String        @id @default(cuid())
  classId     String
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  meetUrl     String?
  status      SessionStatus @default(SCHEDULED)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  class        Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy    User            @relation("SessionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  attendances  Attendance[]
  materials    ClassMaterial[]
  assignments  Assignment[]
  lessonRecord LessonRecord?

  @@index([classId, startTime])
  @@index([status, startTime])
}

model Attendance {
  id          String           @id @default(cuid())
  sessionId   String
  studentId   String
  status      AttendanceStatus @default(ABSENT)
  checkedInAt DateTime?
  markedById  String?
  note        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  session    ClassSession          @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  student    User                  @relation("StudentAttendances", fields: [studentId], references: [id], onDelete: Restrict)
  markedBy   User?                 @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)
  changeLogs AttendanceChangeLog[]

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([sessionId, status])
}

model AttendanceChangeLog {
  id           String           @id @default(cuid())
  attendanceId String
  oldStatus    AttendanceStatus
  newStatus    AttendanceStatus
  changedById  String
  reason       String?
  changedAt    DateTime         @default(now())

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  changedBy  User       @relation("AttendanceModifier", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([attendanceId, changedAt])
  @@index([changedById])
}

model TuitionFee {
  id           String        @id @default(cuid())
  enrollmentId String
  billingYear  Int
  billingMonth Int
  amountDue    Decimal       @db.Decimal(12, 2)
  status       TuitionStatus @default(UNPAID)
  dueDate      DateTime?
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  enrollment Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  payments   TuitionPayment[]

  @@unique([enrollmentId, billingYear, billingMonth])
  @@index([enrollmentId, status])
  @@index([billingYear, billingMonth, status])
}

model TuitionPayment {
  id            String    @id @default(cuid())
  tuitionFeeId  String
  amount        Decimal   @db.Decimal(12, 2)
  paymentDate   DateTime  @default(now())
  paymentMethod String?
  isVoided      Boolean   @default(false)
  voidedAt      DateTime?
  voidReason    String?
  voidedById    String?
  recordedById  String
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tuitionFee TuitionFee @relation(fields: [tuitionFeeId], references: [id], onDelete: Restrict)
  recordedBy User       @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  voidedBy   User?      @relation("PaymentVoider", fields: [voidedById], references: [id], onDelete: SetNull)

  @@index([tuitionFeeId, isVoided])
  @@index([recordedById])
  @@index([voidedById])
}

model LessonRecord {
  id              String   @id @default(cuid())
  sessionId       String   @unique
  content         String   @db.Text
  homeworkSummary String?  @db.Text
  teacherNotes    String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  session ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String    @id @default(cuid())
  classId     String
  sessionId   String?
  title       String
  description String?   @db.Text
  fileUrls    String[]  @default([])
  dueDate     DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  class       Class                  @relation(fields: [classId], references: [id], onDelete: Restrict)
  session     ClassSession?          @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdBy   User                   @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submissions AssignmentSubmission[]

  @@index([classId, dueDate])
  @@index([sessionId])
  @@index([createdById])
}

model AssignmentSubmission {
  id            String           @id @default(cuid())
  assignmentId  String
  studentId     String
  attemptNumber Int              @default(1)
  content       String?          @db.Text
  fileUrls      String[]         @default([])
  externalUrl   String?
  submittedAt   DateTime         @default(now())
  score         Decimal?         @db.Decimal(4, 2)
  feedback      String?          @db.Text
  gradedById    String?
  gradedAt      DateTime?
  status        AssignmentStatus @default(SUBMITTED)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  student    User       @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Restrict)
  gradedBy   User?      @relation("SubmissionGrader", fields: [gradedById], references: [id], onDelete: SetNull)

  @@unique([assignmentId, studentId, attemptNumber])
  @@index([assignmentId, status])
  @@index([studentId])
  @@index([gradedById])
}

model ClassMaterial {
  id           String       @id @default(cuid())
  classId      String
  sessionId    String?
  uploadedById String
  title        String
  description  String?
  type         MaterialType
  fileUrl      String?
  externalUrl  String?
  originalName String?
  mimeType     String?
  fileSize     BigInt?
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  class      Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  session    ClassSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  uploadedBy User          @relation("MaterialUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([classId, createdAt])
  @@index([sessionId])
  @@index([uploadedById])
  @@index([type])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  title       String
  content     String           @db.Text
  type        NotificationType
  isRead      Boolean          @default(false)
  readAt      DateTime?
  referenceId String?
  createdAt   DateTime         @default(now())

  recipient User @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead])
  @@index([recipientId, createdAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRevoked])
  @@index([expiresAt])
}

model TeacherCalendarLabel {
  id          String   @id @default(cuid())
  teacherId   String
  name        String
  color       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher User                   @relation("TeacherCalendarLabels", fields: [teacherId], references: [id], onDelete: Restrict)
  events  TeacherCalendarEvent[]

  @@unique([teacherId, name])
  @@index([teacherId])
}

model TeacherCalendarEvent {
  id              String         @id @default(cuid())
  teacherId       String
  classId         String?
  title           String
  description     String?        @db.Text
  address         String?
  location        String?
  meetUrl         String?
  meetingUrl      String?
  startAt         DateTime
  endAt           DateTime
  timezone        String         @default("Asia/Ho_Chi_Minh")
  meetingType     MeetingType    @default(ONLINE_MEET)
  status          ScheduleStatus @default(SCHEDULED)
  labelId         String?
  reminderMinutes Int?
  note            String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  teacher       User                       @relation("TeacherCalendarEvents", fields: [teacherId], references: [id], onDelete: Restrict)
  class         Class?                     @relation(fields: [classId], references: [id], onDelete: SetNull)
  label         TeacherCalendarLabel?      @relation(fields: [labelId], references: [id], onDelete: SetNull)
  participants  CalendarEventParticipant[]
  notifications CalendarNotification[]

  @@index([teacherId, startAt])
  @@index([teacherId, endAt])
  @@index([labelId])
  @@index([classId])
  @@index([status])
}

model CalendarEventParticipant {
  id        String   @id @default(cuid())
  eventId   String
  studentId String
  createdAt DateTime @default(now())

  event   TeacherCalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student User                 @relation("StudentCalendarParticipations", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
  @@index([studentId])
  @@index([eventId])
}

model CalendarNotification {
  id          String                     @id @default(cuid())
  eventId     String
  recipientId String
  scheduledAt DateTime
  status      CalendarNotificationStatus @default(PENDING)
  sentAt      DateTime?
  error       String?
  retryCount  Int                        @default(0)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  event     TeacherCalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipient User                 @relation("CalendarNotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([eventId, recipientId])
  @@index([recipientId])
}
